{
  "AuthOptions": {
    "Issuer": "CourseManagement.AUTH",
    "Audience": "CourseManagement.API",
    "ValidAlgorithms":  [ "HS256" ],
    "Secret": "0889f724-4d07-4478-92a9-eaef268a1a84",
    "AccessTokenExpireInSeconds": "900", // 15 minutes
    "RefreshTokenExpireInMinutes": "21600" // 15 days
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "path": "logs/course-management-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "CourseManagement"
    }
  },
  "AllowedHosts": "*"
}
